/**
 * Simple Lingua Franca example from the official documentation. A timer triggers periodically and
 * prints a count with elapsed logical time. Based on:
 * https://www.lf-lang.org/docs/writing-reactors/timers-and-operators
 *
 * @author Filippo Camossi
 */
target C {
  timeout: 5 sec
}

main reactor {
  timer t(0, 500 ms)
  state count: int = 0

  reaction(startup) {=
    lf_print("Hello from Lingua Franca!");
  =}

  reaction(t) {=
    self->count++;
    lf_print("Timer tick %d at elapsed logical time: " PRINTF_TIME " nsec",
      self->count, lf_time_logical_elapsed());
  =}

  reaction(shutdown) {=
    lf_print("Execution finished. Total ticks: %d", self->count);
  =}
}
